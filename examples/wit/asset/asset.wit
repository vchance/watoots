package watoots:asset@0.1.0;

/// The types an asset plugin works in.
///
/// Deliberately no file format anywhere: the host decodes PNG and hands over
/// pixels. That is how a real pipeline is built — you decode once at the edge
/// rather than making every plugin carry a codec — and it is also the only way
/// four guest languages can agree byte for byte without four PNG dependencies.
interface types {
  /// Decoded pixels, RGB8, row-major.
  ///
  /// `pixels` is `width * height * 3` bytes. A plugin that returns anything
  /// else gets its output rejected by the host rather than trusted, because a
  /// length that disagrees with the dimensions is exactly the kind of thing an
  /// untrusted plugin should not be able to make the host act on.
  record image {
    width: u32,
    height: u32,
    pixels: list<u8>,
  }

  enum channel {
    red,
    green,
    blue,
  }

  record gain {
    channel: channel,
    /// Multiplier.
    ///
    /// A guest clamps this to `0.0..=4.0` and treats NaN as `0.0`. Saying so
    /// here rather than "the host clamps it" is the difference between a rule
    /// and a hope: nothing in the type system makes a host do that, NaN is
    /// representable, and the wrong answer differs by language — Rust's
    /// `as u8` saturates, C++'s conversion is undefined behaviour.
    factor: f32,
  }

  record extent {
    width: u32,
    height: u32,
  }

  /// Which kind of step, without its parameters.
  ///
  /// `describe` needs to say "I can do gain" without inventing a gain to say
  /// it with. Reusing `operation` there forced a plugin to construct a whole
  /// record of meaningless values — `gain({channel: red, factor: 1})` — that a
  /// host had to know to ignore, with nothing in the type saying so. Four
  /// guests would have invented four different sets of noise.
  /// Kept in step with `operation` by hand — nothing in WIT derives one from
  /// the other. A case added to one and not the other compiles on both sides,
  /// and the result is a plugin advertising a step nobody can send, or refusing
  /// one it implements.
  enum operation-kind {
    grayscale,
    invert,
    gain,
    resize,
    lut,
  }

  /// One step of a pipeline.
  ///
  /// A variant rather than a string plus arguments: the shape of each step's
  /// parameters is part of the type, so a plugin cannot be handed a `resize`
  /// with no dimensions, and the host cannot forget to send them.
  variant operation {
    /// Rec. 601 luma, replicated across all three channels.
    grayscale,
    invert,
    gain(gain),
    /// Nearest-neighbour, top-left biased: source pixel
    /// `(dx * src-width / dst-width, dy * src-height / dst-height)`, truncating.
    /// Ugly on purpose — four languages have to agree on every output byte, and
    /// interpolation invites disagreement.
    ///
    /// A destination whose pixel buffer would exceed **32 MiB** is `malformed`.
    /// Without a stated bound each guest invents one, and they disagree at the
    /// edge — and a guest that instead *tries* the allocation fails it, which
    /// in Rust is an abort and reaches the host as a trap, defeating the point
    /// of returning `result` at all.
    ///
    /// A zero-width or zero-height destination is a zero-pixel image, not an
    /// error. Sampling a zero-area *source* into a non-empty destination is
    /// `malformed`, because there is no pixel to copy.
    resize(extent),
    /// Apply a colour lookup table the plugin reads from a file.
    ///
    /// This is the step that needs a capability. The plugin opens the file
    /// itself, so `fs.read` has to be granted and scoped — and a manifest that
    /// does not grant it fails the *load*, before any pixel is touched.
    ///
    /// The string is a **path, spelled the way the grant spells it**, not a
    /// name the plugin can resolve. A guest has no way to look a bare name up:
    /// this world does not import `wasi:filesystem/preopens`, and a directory
    /// is preopened under the same string it was granted as. So a grant of
    /// `${plugin_dir}/luts` expanded to an absolute path wants an absolute
    /// argument, and one that stayed relative wants a relative one. Nothing in
    /// the type says this, which is why it says it here.
    lut(string),
  }

  /// Why a step could not be done.
  ///
  /// **The strings here are for people, not for hosts.** A host branches on the
  /// case; it must not match on the prose, and two guests wording the same
  /// failure differently are both conforming.
  ///
  /// That is a decision, not an omission. Making the wording normative sounds
  /// harmless until you implement it: matching one reference guest's messages
  /// meant reproducing five separate behaviours of *its standard library* —
  /// its debug string escaping, its integer parser's error text, its line
  /// splitting, its UTF-8 error wording, and its `io::Error` rendering. None of
  /// that is in this file, none of it is about images, and asking a guest whose
  /// runtime is CPython or a JavaScript engine to reproduce it would be asking
  /// it to impersonate a language it is not written in.
  ///
  /// What every guest *does* owe byte for byte is the pixels, and the case it
  /// returns.
  ///
  /// `result<image, failure>` rather than a trap: "I cannot do this" is an
  /// answer, not a crash, and a plugin that traps on bad input is a plugin you
  /// cannot tell apart from one that has a bug.
  record file-failure {
    /// The path, exactly as the `lut` step spelled it.
    path: string,
    /// Why, in words meant for a person. The manifest is usually the answer.
    reason: string,
  }

  variant failure {
    /// A step this plugin does not implement.
    ///
    /// `operation-kind` rather than a string: two guests would spell the same
    /// step differently, and a host would have to match prose. It can only ever
    /// name a case the guest knows and declined — a step whose discriminant its
    /// bindings do not know fails to lift long before this.
    unsupported(operation-kind),
    /// The input did not describe an image — usually a pixel buffer whose
    /// length disagrees with the dimensions.
    malformed(string),
    /// A `lut` step's file could not be turned into a table — not found, not
    /// permitted, or not a lookup table.
    ///
    /// Carries a reason as well as the path, because those causes want
    /// different fixes and a bare path cannot tell them apart. Reporting a bad
    /// table as `malformed` would be worse: that is documented as being about
    /// the image, and would send a host to look at its pixels.
    ///
    /// A guest cannot distinguish the first two. WASI reports a path outside
    /// every preopened directory as not-found, byte-identical to a missing file
    /// inside a granted one — correctly, because a sandbox that answered
    /// "exists, but you may not have it" would leak what it is hiding. So
    /// "not permitted" arrives as "not found", and the reason can only hint.
    /// The check is the manifest, which is why the reason says so.
    ///
    /// `reason` is prose, deliberately. An enum beside it would be false
    /// precision over causes the guest cannot actually separate.
    unreadable(file-failure),
  }
}

/// What a plugin says about itself, before it is asked to do anything.
interface manifest {
  use types.{operation-kind};

  record plugin-info {
    name: string,
    /// One entry per step the plugin implements. The host uses this to route
    /// a pipeline, and to refuse one no loaded plugin can complete.
    supports: list<operation-kind>,
  }
}

/// The one capability this world's *application* offers. Everything else a
/// plugin can reach comes from WASI and must be granted by the manifest.
interface log {
  enum level {
    debug,
    info,
    warning,
    error,
  }

  emit: func(level: level, message: string);
}

/// A plugin over the asset pipeline.
///
/// Several obligations here are doc comments rather than types — `resize`'s
/// 32 MiB bound, `gain`'s clamp, the rounding in every operation. WIT cannot
/// express them, so a guest that ignores one still compiles and still passes
/// any test that does not probe the edge. `crates/host/tests/asset_e2e.rs` is
/// therefore part of this definition, not merely a test of one guest: it is
/// where "four languages produce the same bytes" is actually enforced.
world asset-plugin {
  use types.{image, operation, failure};
  use manifest.{plugin-info};

  import log;

  /// Name and capabilities. Called before any image is handed over, so a host
  /// can build a pipeline without trial and error.
  export describe: func() -> plugin-info;

  /// Run a pipeline over one image.
  ///
  /// Steps apply in order. The whole call fails on the first step that cannot
  /// be done, and the failure names it — a partly-transformed image would be
  /// worse than none, because nothing downstream could tell.
  export apply: func(input: image, steps: list<operation>) -> result<image, failure>;
}
