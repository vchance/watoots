@PACKAGE_INIT@

# A consumer links a prebuilt library and reads committed headers. No Rust
# toolchain, no cargo, no cbindgen -- see docs/adr/0005-cargo-from-cmake.md.

if(NOT TARGET watoots::capi)
  add_library(watoots::capi STATIC IMPORTED)
  set_target_properties(
    watoots::capi
    PROPERTIES IMPORTED_LOCATION
               "${PACKAGE_PREFIX_DIR}/lib/libwatoots_capi.a"
               INTERFACE_INCLUDE_DIRECTORIES
               "${PACKAGE_PREFIX_DIR}/include"
               INTERFACE_COMPILE_FEATURES
               "c_std_11;cxx_std_20"
               INTERFACE_LINK_LIBRARIES
               "@WATOOTS_SYSTEM_LIBS@")
endif()

check_required_components(watoots)
